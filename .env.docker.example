# Configuración del despliegue.
#
#   cp .env.docker.example .env.docker
#
# Se edita el archivo copiado y se levanta con `docker compose up -d`. No se
# versiona, así que es el lugar de las credenciales.

APP_NAME=NavSpace
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Dirección desde la que el visor Meta Quest descarga los modelos. No hace falta
# un dominio: sirve la IP del servidor, por ejemplo http://192.168.1.50:8000. Si
# queda en localhost el visor la buscará en sí mismo y no encontrará nada.
APP_URL=http://localhost:8000

# Carga los datos de ejemplo del DICI en el primer arranque.
DB_SEED=true

# --- Correo --------------------------------------------------------------
# Necesario para la recuperación de contraseña y la verificación de cuenta.
#
# MAIL_PASSWORD no es la clave de la cuenta de Google, sino una "contraseña de
# aplicación" de 16 caracteres que se genera en la configuración de seguridad de
# Google, con la verificación en dos pasos ya activada.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS=tucorreo@gmail.com
MAIL_FROM_NAME=NavSpace

# Para probar sin una cuenta real, comenta el bloque anterior y usa este: los
# mensajes quedan en el buzón de prueba, visible en http://localhost:8025
# MAIL_MAILER=smtp
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_FROM_ADDRESS=no-reply@navspace.local
# MAIL_FROM_NAME=NavSpace
