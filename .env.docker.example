# Configuración del despliegue con Docker.
#
#   cp .env.docker.example .env.docker
#
# Edita los valores que necesites y levanta con `docker compose up -d`.
# Este archivo no se versiona, así que es el lugar para las credenciales.

APP_NAME=NavSpace
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Debe apuntar al dominio real al desplegar en un servidor: la API entrega en
# model_url e image_url rutas absolutas construidas con esta variable, y si
# queda en localhost la app de Unity no podrá descargar los modelos.
APP_URL=http://localhost:8000

# Carga los datos de ejemplo del DICI en el primer arranque.
DB_SEED=true

# --- Correo --------------------------------------------------------------
# Necesario para la recuperación de contraseña y la verificación de cuenta.
#
# Por defecto se usa Mailpit, el buzón de prueba que viene en el compose: los
# mensajes no salen a internet y se leen en http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@navspace.local
MAIL_FROM_NAME=NavSpace

# Para enviar correo real con Gmail, comenta las cuatro líneas de arriba y usa
# estas. La contraseña no es la de la cuenta, sino una "contraseña de
# aplicación" que se genera en la configuración de seguridad de Google.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=tucorreo@gmail.com
# MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_FROM_ADDRESS=tucorreo@gmail.com
# MAIL_FROM_NAME=NavSpace
