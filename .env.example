# Configuración de NavSpace.
#
#   cp .env.example .env
#
# Se edita el archivo copiado antes de levantar el sistema. No se versiona, así
# que es el lugar de las credenciales.

APP_NAME=NavSpace
APP_ENV=production
APP_DEBUG=false

# Cifra las sesiones y los secretos de doble factor. Se genera sola en el primer
# arranque, pero la línea debe existir aunque quede vacía.
APP_KEY=

# Dirección desde la que el visor Meta Quest descarga los modelos. No hace falta
# un dominio: sirve la IP del servidor, por ejemplo http://192.168.1.50:8000. Si
# queda en localhost el visor la buscará en sí mismo y no encontrará nada. Debe
# incluir el mismo puerto que APP_PORT.
APP_URL=http://localhost:8000

# Puerto por el que se publica el panel. Se cambia cuando el servidor ya tiene
# otro servicio ocupando el 8000, recordando ajustar también APP_URL.
APP_PORT=8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Toda la información se guarda en un archivo SQLite, sin un motor aparte.
DB_CONNECTION=sqlite

# Carga los datos de ejemplo del edificio DICI en el primer arranque.
DB_SEED=true

# --- Administrador inicial -----------------------------------------------
# Cuenta con la que se entra al panel, creada en el primer arranque. Si se dejan
# vacías se usan los valores de ejemplo (test@example.com / password), que
# conviene reemplazar en un despliegue real.
ADMIN_NAME="Administrador NavSpace"
ADMIN_EMAIL=test@example.com
ADMIN_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Correo --------------------------------------------------------------
# Servidor SMTP desde el que salen los correos de recuperación de contraseña y
# de verificación de cuenta. Sirve cualquiera: Gmail, el del hosting o uno en la
# nube como Brevo, Resend o Mailgun.
#
# Con MAIL_MAILER=log los mensajes se escriben en el registro en lugar de
# enviarse: el panel funciona, pero la recuperación de contraseña no le llega al
# usuario. Para enviar de verdad se cambia a smtp y se completan las credenciales.
#
# El ejemplo es Gmail. Ahí MAIL_PASSWORD no es la clave de la cuenta, sino una
# "contraseña de aplicación" de 16 caracteres que se genera en la configuración
# de seguridad de Google, con la verificación en dos pasos ya activada.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@navspace.cl
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
