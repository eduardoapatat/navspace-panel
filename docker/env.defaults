# Values baked into the image so the panel runs without any configuration, which
# is what happens when nobody creates a .env.docker file. Mail is pointed at the
# bundled Mailpit inbox because there are no real SMTP credentials to ship.
#
# Anything defined in .env.docker overrides these.

# Filled in by the entrypoint on the first run. The line must exist beforehand:
# `key:generate` replaces it instead of appending it.
APP_KEY=

APP_NAME=NavSpace
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_URL=http://localhost:8000

DB_SEED=true

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@navspace.local
MAIL_FROM_NAME=NavSpace
